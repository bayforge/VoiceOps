# Server
PORT=8787
REPO_ROOT=
VITE_API_BASE_URL=http://127.0.0.1:8787

# Phase 1/2 guardrail
# The app only returns mock responses in this phase.
AGENT_RUNNER_MODE=mock

# Phase 3 voice layer
# Leave these defaults for a credential-free demo.
VOICE_STT_MODE=mock
VOICE_TTS_MODE=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
