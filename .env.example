# Server
PORT=8787
REPO_ROOT=
VITE_API_BASE_URL=http://127.0.0.1:8787

# Phase 4 runner
# Keep mock for the safest demo path. Shell mode only runs configured commands.
AGENT_RUNNER_MODE=mock
AGENT_COMMAND=
BUILD_COMMAND=npm run build
TEST_COMMAND=npm test
TYPECHECK_COMMAND=npm run typecheck

# Phase 3 voice layer
# Leave these defaults for a credential-free demo.
VOICE_STT_MODE=mock
VOICE_TTS_MODE=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v2_realtime
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
