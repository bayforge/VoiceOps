# Server
PORT=8787
REPO_ROOT=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Agent runner
# Use "mock" for safe demo mode.
# Use "shell" only when you intentionally want the app to execute local commands.
AGENT_RUNNER_MODE=mock

# Optional shell agent command.
# Keep blank until shell mode is intentionally enabled.
AGENT_COMMAND=

# Local validation commands
BUILD_COMMAND=npm run build
TEST_COMMAND=npm test
TYPECHECK_COMMAND=npm run typecheck

# Demo
DEMO_MODE=true